# "development" and "test" switch the start-up safety checks OFF and let messages be logged instead of sent. A real deployment must NOT use them
# (left out, the value is "production"; docker-compose.yml sets it itself).
ENVIRONMENT=development
# Logging: DEBUG | INFO | WARNING | ERROR; format json | text | auto (text in development and tests, json elsewhere)
LOG_LEVEL=INFO
LOG_FORMAT=auto
# Error reporting: ERROR-level log lines go to Sentry when this is set (no request data or personal data is sent)
SENTRY_DSN=
# Google Calendar sync (README: Google Calendar sync). An OAuth client of type "web application" made in Google Cloud; all three or none.
# The redirect URI must be registered there and is this server's /v1/calendar/oauth/callback. CALENDAR_DONE_URL = where the owner's browser lands afterwards.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
CALENDAR_DONE_URL=
# The owner signs in by email (README: Owner sign-in and lost keys): where the emailed link leads ({token} is replaced; unset = the email carries the bare token),
# how long it works (seconds), and the pause (seconds) before another may be asked for
OWNER_LOGIN_URL=
OWNER_LOGIN_TTL_SECONDS=900
OWNER_LOGIN_COOLDOWN_SECONDS=60
# Sign-up refuses throw-away email addresses (a built-in list). JSON lists: domains to refuse as well, and domains to accept although they are on the list
# BLOCKED_EMAIL_DOMAINS=["tempmail.example"]
# ALLOWED_EMAIL_DOMAINS=[]
# A business is emailed when it uses this percentage of one of its plan's limits, and again at the limit (0 = never)
PLAN_WARNING_PERCENT=80
# Bot check in front of sign-up and guest booking (README: Bot check). Cloudflare Turnstile: both keys come from its dashboard; the site key is public
# (goes into the web page), the secret key must stay here. Empty provider = no check. Cloudflare publishes dummy keys for trying it (see the README).
CAPTCHA_PROVIDER=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true = when Cloudflare cannot be reached let requests through instead of refusing them with 503 (customers keep booking; so can bots)
CAPTCHA_FAIL_OPEN=false
# Serve /docs, /redoc and /openapi.json. Unset: on in development and tests, off elsewhere
# DOCS_ENABLED=true
# At most this many sign-in codes / links per phone or email per business per day (0 = no cap), and sign-up emails per address per day
SIGN_IN_REQUESTS_PER_DAY=10
SIGNUP_REQUESTS_PER_ADDRESS_PER_DAY=5
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking
# A Redis anywhere but this machine needs a password in the address: redis://:PASSWORD@host:6379/0 (docker-compose.yml builds it from REDIS_PASSWORD)
REDIS_URL=redis://localhost:6379/0
# Availability answers may be served from Redis for this long; 0 turns the cache off. Writes invalidate at once.
AVAILABILITY_CACHE_TTL_SECONDS=30
# Background worker (python -m app.worker): how often it sweeps, and how old a new booking must be before its flags are checked
SWEEP_INTERVAL_SECONDS=60
SWEEP_GRACE_SECONDS=60
# Published outbox events are deleted after this many days
OUTBOX_RETENTION_DAYS=7
# PDPA: clear health notes this many days after a booking ended (0 = keep them)
HEALTH_NOTES_RETENTION_DAYS=0
CORS_ORIGINS=["http://localhost:3000"]
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PDPA_ENCRYPTION_KEY=change-me
# Bootstraps tenants via POST /v1/auth/tenants
PLATFORM_ADMIN_TOKEN=change-me

# --- Sign-in codes and customer messages (see README: Notifications) ---
# Channel for OTP codes: whatsapp or sms. In development messages are only logged; elsewhere a channel without a provider fails visibly.
OTP_CHANNEL=whatsapp
# Where the emailed sign-in link leads ({token} is replaced). Unset: the email carries the bare token.
MAGIC_LINK_URL=
# Minutes before a booking starts from which staff may mark it in-progress or completed (no-show only from its start)
STATUS_EARLY_MINUTES=60
# Where the link that confirms a customer's email leads ({token} is replaced). Unset: the email carries the bare token.
EMAIL_CONFIRM_URL=
# The platform-wide default page for the review link in the completed-visit message ({token} is replaced). A business sets its own in its profile; with neither, no link.
REVIEW_URL=
# How long a review link works
REVIEW_LINK_DAYS=30
# Email through SMTP; without SMTP_HOST no email provider is registered (development logs messages instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bookings@example.com
# Default hours before a confirmed booking at which reminders go out (JSON list; [] = none). Each business can choose its own via the admin API.
REMINDER_HOURS=[24, 2]

# --- Outgoing webhooks. WEBHOOK_ALLOW_INSECURE is for development only: it lets webhooks target http:// and private addresses ---
WEBHOOK_ALLOW_INSECURE=false

# --- Rate limiting (README: Rate limiting) ---
RATE_LIMIT_ENABLED=true
# Number of reverse proxies in front of the API. 0 = no proxy: the socket address is the client. MUST be set behind a proxy.
RATE_LIMIT_TRUSTED_PROXIES=0
# Optional overrides, e.g. {"auth_send": {"ip": [5, 60]}}  (requests, window seconds)
# RATE_LIMITS={}

# --- WhatsApp Cloud API (Meta). Registered only when BOTH the token and the phone number id are set ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Sign-in codes: the NAME of an approved Meta template whose body takes the code as its one variable (Meta refuses plain text to start a conversation)
WHATSAPP_OTP_TEMPLATE=
# true for Meta "authentication" templates (they have a copy-code button that takes the code); false for a plain body-only template
WHATSAPP_OTP_BUTTON=true
# The language the templates were approved in
WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_API_VERSION=v21.0

# --- SMS gateway: SMS_PROVIDER=twilio needs the account, the token and a sender number OR a messaging service ---
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# --- Production database (README: "Production setup"). Three roles, created by deploy/postgres/01_roles.sql ---
# DATABASE_URL must be the limited application role (booking_app). Migrations run as the table owner:
# MIGRATION_DATABASE_URL=postgresql+asyncpg://booking_owner:<owner password>@postgres:5432/booking
# Used by docker-compose.yml (URL-safe characters only, e.g. `openssl rand -hex 24`):
# POSTGRES_PASSWORD=
# BOOKING_OWNER_PASSWORD=
# BOOKING_APP_PASSWORD=
# BOOKING_BACKUP_PASSWORD=
# REDIS_PASSWORD=
# Emergency only: start although the start-up checks refuse (superuser database role, placeholder secrets). Never keep this on.
# ALLOW_UNSAFE_STARTUP=false

# --- Looking up typed addresses for on-site bookings (README: "Typed addresses"). Without a provider customers must send their map-pin coordinates ---
GEOCODING_PROVIDER=
GOOGLE_MAPS_API_KEY=
